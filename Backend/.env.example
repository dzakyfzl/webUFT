# Set to the approved PostgreSQL target outside Docker.
# Use the SQLAlchemy postgresql+psycopg URL scheme. No fallback is provided.
DATABASE_URL=
ERP_ENV=development
ERP_PUBLIC_ORIGIN=http://localhost:3000
ERP_SESSION_TTL_SECONDS=43200
ERP_LOGIN_MAX_ATTEMPTS=5
ERP_LOGIN_WINDOW_SECONDS=900
ERP_DB_POOL_SIZE=3
ERP_DB_MAX_OVERFLOW=2
# Persistent private uploads; include this directory in backup/restore with PostgreSQL.
ERP_MEDIA_DIR=var/media
