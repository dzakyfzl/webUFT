# Database (PostgreSQL) — dipecah per-komponen
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DATABASE=UFT
# Override manual (opsional, jarang dipakai):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Auth
ADMIN_USERNAME=
ADMIN_PASSWORD=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTE=10
REFRESH_TOKEN_EXPIRE_DAYS=1

# App
IMAGE_QUALITY=50
NEXT_PUBLIC_SHORTLINK_DOMAIN=localhost:3000
NEXT_PUBLIC_SHORTLINK_SUBDOMAIN=link

# Environment
BACKEND_URL=http://localhost:8000
APP_ENV=local

# Chatbot Angie — AI Assistant
# Generate CHATBOT_MASTER_KEY dengan: python -c "import secrets; print(secrets.token_hex(32))"
# WAJIB diisi sebelum chatbot digunakan. Simpan backup di password manager, bukan di repo!
CHATBOT_MASTER_KEY=              # 64-char hex string (AES-256-GCM master key)
CHATBOT_MODEL=gemini-2.0-flash-lite
CHATBOT_EMBEDDING_MODEL=text-embedding-004
CHATBOT_DAILY_TOKEN_LIMIT=1000000
CHATBOT_SIMILARITY_THRESHOLD=0.75
CHATBOT_MAX_RETRIES=3
# Batas maksimal request chatbot yang boleh berjalan BERSAMAAN di server.
# Mencegah chatbot memonopoli seluruh DB connection pool saat traffic spike.
# Default: 5 (aman untuk pool_size=10 + max_overflow=20)
CHATBOT_MAX_CONCURRENT=5
